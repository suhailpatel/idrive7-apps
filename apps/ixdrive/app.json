        "D8D8",
        "D8D9",
        "D8DB",
        "D8DD",
        "D8DE",
        "D8DF",
        "D8E1",
        "D8E2",
        "D905",
        "D918",
        "D9A7",
        "D9AC",
        "D9AD",
        "4020",
        "4021",
        "4022",
        "4023",
        "4024",
        "4026",
        "4027",
        "4036",
        "4038",
        "4039",
        "403C",
        "403D"
      ]
    }
  }
