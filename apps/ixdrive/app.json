  "config": {
    "comment": "Read-only UDS candidates inherited from eDrive, not validated on the G08 iX3. Validate ECU, payload, units and sign on each vehicle. Capacity and SOH candidates stay empty until their usable-kWh/health meaning is verified. Current usable capacity can be learned from synchronized power and displayed SOC. No model name or nominal battery size is assumed.",
    "battery": {
      "ecu": 7,
      "soc": [
        {
          "did": "DDBC",
          "bytes": 2,
          "at": 0,
          "factor": 0.1,
          "offset": 0,
          "min": 0,
          "max": 100
        }
      ],
      "soh": [],
      "v12": [
        {
          "ecu": 7,
          "did": "F442",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 5,
          "max": 18
        }
      ],
      "chargeMinPct": 1,
      "powerSign": -1,
      "fast": {
        "hvV": [
          {
            "did": "DDB4",
            "timeoutMs": 600,
            "fields": {
              "v": {
                "bytes": 2,
                "factor": 0.01,
                "min": 150,
                "max": 500
              }
            },
            "note": "confirmed on the X5 45e"
          },
          {
            "did": "DD68",
            "fields": {
              "v": {
                "bytes": 2,
                "factor": 0.01,
                "min": 150,
                "max": 500
              }
            }
          },
          {
            "did": "DD66",
            "fields": {
              "v": {
                "bytes": 2,
                "factor": 0.01,
                "min": 150,
                "max": 500
              }
            }
          },
          {
            "did": "DDEF",
            "fields": {
              "v": {
                "bytes": 2,
                "factor": 1,
                "min": 150,
                "max": 500
              }
            }
          }
        ],
        "hvI": [
          {
            "did": "DD69",
            "timeoutMs": 600,
            "fields": {
              "a": {
                "bytes": 4,
                "factor": 0.01,
                "signed": true,
                "min": -2000,
                "max": 2000
              }
            }
          }
        ]
      },
      "slow": {
        "soc": [
          {
            "did": "DDBC",
            "fields": {
              "pct": {
                "bytes": 2,
                "factor": 0.1,
                "min": 0,
                "max": 100
              }
            }
          }
        ],
        "cellV": [
          {
            "did": "DFA5",
            "array": {
              "bytes": 2,
              "factor": 0.001,
              "min": 2.5,
              "max": 4.4
            },
            "note": "every cell's voltage, 2 bytes each (96 on the X5 45e): found with the Scan page"
          },
          {
            "did": "DDBF",
            "fields": {
              "min": {
                "at": 0,
                "bytes": 2,
                "factor": 0.001,
                "min": 2.5,
                "max": 4.4
              },
              "max": {
                "at": 2,
                "bytes": 2,
                "factor": 0.001,
                "min": 2.5,
                "max": 4.4
              }
            }
          }
        ],
        "cellT": [
          {
            "did": "DDC0",
            "fields": {
              "min": {
                "at": 0,
                "bytes": 2,
                "factor": 0.01,
                "signed": true,
                "min": -40,
                "max": 80
              },
              "max": {
                "at": 2,
                "bytes": 2,
                "factor": 0.01,
                "signed": true,
                "min": -40,
                "max": 80
              },
              "avg": {
                "at": 4,
                "bytes": 2,
                "factor": 0.01,
                "signed": true,
                "min": -40,
                "max": 80
              }
            }
          }
        ],
        "coolant": [
          {
            "did": "DD6C",
            "fields": {
              "t": {
                "bytes": 2,
                "factor": 0.01,
                "signed": true,
                "min": -40,
                "max": 100
              }
            }
          }
        ],
        "limits": [
          {
            "did": "DD7D",
            "fields": {
              "chargeA": {
                "at": 0,
                "bytes": 2,
                "factor": 0.1,
                "min": 0,
                "max": 2000
              },
              "dischargeA": {
                "at": 2,
                "bytes": 2,
                "factor": 0.1,
                "min": 0,
                "max": 2000
              }
            }
          }
        ]
      },
      "socWindow": {
        "empty": 0,
        "full": 100,
        "comment": "Expected displayed SOC. If the verified DID reports physical SOC, set its measured empty/full limits; shared by the main page and live/widget reader."
      },
      "capacity": []
    },
    "scaling": {
      "batteryTemp": {
        "factor": 1,
        "offset": -50,
        "invalid": 255,
        "comment": "HV battery temperature (Efficiencytainment2.statusBatteryTemperature, avg / min / max): raw on the Signals page - adjust if it doesn't match. X5 45e: raw 76 with the cells at ~26 C (DDC0), so -50"
      },
      "ambient": {
        "factor": 0.5,
        "offset": -40,
        "invalid": 255
      },
      "acPower": {
        "factor": 0.001,
        "offset": 0,
        "invalid": 65535,
        "max": 8,
        "comment": "Climate2.statusActualValuePowerACCompressor -> kW. Assumed to come in W: check the raw value on the Signals page with the A/C on (an electric compressor uses ~0.5-4 kW) and adjust factor if needed"
      }
    },
    "probes": [
      {
        "name": "ac",
        "ecu": 120,
        "did": "D8D2",
        "at": 1,
        "bytes": 2,
        "factor": 0.001,
        "note": "IHKA: A/C compressor power in W (X5 45e: 280-680 W on LO)"
      },
      {
        "name": "heater",
        "ecu": 120,
        "did": "D8D3",
        "at": 1,
        "bytes": 2,
        "factor": 0.001,
        "note": "IHKA: HV heater power in W (X5 45e: 5520 W on HIGH, matched the battery measurement)"
      }
    ],
    "scanKnown": {
      "comment": "identifiers that answered a full scan on the X5 45e: the live comparison reads these when the unit has no saved scan",
      "120": [
        "D8C3",
        "D8C4",
        "D8C5",
        "D8C7",
        "D8CB",
        "D8CC",
        "D8CD",
        "D8D0",
        "D8D2",
