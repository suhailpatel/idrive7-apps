{
  "id": "ixdrive",
  "title": "iXDrive",
  "description": "Battery-electric telemetry for iDrive 7, focused on the G08 iX3: automatic battery-capacity learning and power scales, range, cells, charging estimates and history. iDrive 7 runtime; vehicle diagnostics require validation.",
  "version": "0.1.0",
  "vendor": "custom",
  "loggingId": "OAXD",
  "iconGlyph": "iX",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "highVoltageStorageInfoToExternal": "s"
    },
    "de.bmw.infotainment.climate.climatemaster.ClimateMaster": {
      "statusClimateSystemOn": "rs",
      "statusAirCondAC": "rs"
    },
    "de.bmw.infotainment.climate.Climate2": {
      "statusACFront": "rs",
      "statusAirConditionDRStatus": "rs",
      "statusActualValuePowerACCompressor": "rs"
    },
    "de.bmw.infotainment.climate.Climate": {
      "statusSeatHeatingDR": "rs",
      "statusSeatHeatingPS": "rs",
      "statusSeatHeatingDRR": "rs",
      "statusSeatHeatingPSR": "rs"
    },
    "de.bmw.body.steeringwheelcomfort.SteeringWheelClimate": {
      "heatingState": "rs"
    },
    "de.bmw.infotainment.KombiIF": {
      "statusDisplayElectricalPowerDistribution": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.Efficiencytainment2": {
      "statusBatteryTemperature": "rs"
    },
    "de.bmw.infotainment.lsc.LSCDataSink": {
      "statusHighVoltageStorage": "s"
    }
  },
  "startWidget": {
    "comment": "Home-screen widget. Layout and cell names are those of BMW's Drive Recorder widget on this firmware: the drawn image goes into BackgroundImage1, the layout shows Title above it. If the image doesn't show or sits wrong, try another 'image' cell or adjust 'size' (pixels: the HMI scales the picture to the big widget and crops it centred; 384 x 256 fits the G05).",
    "name": "iXDrive",
    "layout": "LT_Table_OnlineApps_DriveRecorderWidget",
    "image": "BackgroundImage1",
    "scale": 2,
    "size": [
      384,
      256
    ],
    "safe": [
      0.09,
      0.17
    ],
    "cells": {
      "ErrorInfo": [
        false,
        "Bool"
      ],
      "background": [
        true,
        "Bool"
      ],
      "ProgressbarVisible": [
        false,
        "Bool"
      ],
      "TextRecordings": [
        "",
        "Text"
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "iXDrive",
      "buttons": [
        [
          "BTN_READ",
          "Read now"
        ],
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_PREV",
          "Previous page"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "reserve",
      "label": "Arrival reserve",
      "type": "choice",
      "default": "0",
      "options": [
        [
          "0",
          "0 %"
        ],
        [
          "5",
          "5 %"
        ],
        [
          "10",
          "10 %"
        ],
        [
          "15",
          "15 %"
        ],
        [
          "20",
          "20 %"
        ]
      ]
    },
    {
      "key": "chargeTarget",
      "label": "Charge estimate target (does not control car)",
      "type": "number",
      "unit": "%",
      "default": 80,
      "steps": [
        50,
        60,
        70,
        80,
        90,
        100
      ]
    },
    {
      "key": "price",
      "label": "Electricity price",
      "type": "number",
      "unit": "EUR/kWh",
      "default": 0.25,
      "steps": [
        0,
        0.05,
        0.1,
        0.12,
        0.15,
        0.16,
        0.17,
        0.18,
        0.19,
        0.2,
