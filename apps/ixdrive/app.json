        0.22,
        0.23,
        0.24,
        0.25,
        0.26,
        0.27,
        0.28,
        0.29,
        0.3,
        0.31,
        0.32,
        0.33,
        0.34,
        0.35,
        0.36,
        0.37,
        0.38,
        0.39,
        0.4,
        0.45,
        0.5,
        0.55,
        0.6,
        0.7
      ]
    },
    {
      "key": "distUnit",
      "label": "Distance unit",
      "type": "choice",
      "default": "km",
      "options": [
        [
          "km",
          "km"
        ],
        [
          "mi",
          "miles"
        ]
      ]
    },
    {
      "key": "tempUnit",
      "label": "Temperature unit",
      "type": "choice",
      "default": "c",
      "options": [
        [
          "c",
          "Celsius"
        ],
        [
          "f",
          "Fahrenheit"
        ]
      ]
    },
    {
      "key": "diagPage",
      "label": "Diagnostics pages (UDS replies, scan, raw signals)",
      "type": "bool",
      "default": false
    },
    {
      "key": "poll",
      "label": "Read charge every",
      "type": "number",
      "unit": "s",
      "default": 15,
      "steps": [
        5,
        10,
        15,
        30,
        60
      ],
      "when": {
        "diagPage": true
      }
    },
    {
      "key": "sohDays",
      "label": "Read battery health every",
      "type": "number",
      "unit": "days",
      "default": 7,
      "steps": [
        1,
        7,
        30
      ],
      "when": {
        "diagPage": true
      }
    },
    {
      "key": "widgetFps",
      "label": "Home-screen widget: redraw per second",
